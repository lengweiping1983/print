{
  "name": "garment-print-studio",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web",
    "packages/shared-types"
  ],
  "scripts": {
    "dev:web": "npm --workspace apps/web run dev",
    "dev:api": "cd apps/api && python3 -m uvicorn app.main:app --reload --port 8000",
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "test:api": "cd apps/api && python3 -m pytest",
    "typecheck": "npm --workspace apps/web run typecheck"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}

